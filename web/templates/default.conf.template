server {
    listen 80;
    server_name _;
    client_max_body_size 3m;

    # Frontend - static files
    root /usr/share/nginx/html;
    index index.html;

    # Never cache HTML, CSS and JS so the browser always gets the latest version.
    # ETag/304 still works, so bandwidth is only used when a file actually changed.
    location ~* \.(html|css|js)$ {
        add_header Cache-Control "no-cache, must-revalidate";
        etag on;
        try_files $uri $uri/ /index.html;
    }

    # API reverse proxy. ${API_HOST}/${API_PORT} worden bij het starten door envsubst
    # ingevuld (zie Dockerfile); nginx-variabelen als $uri blijven ongemoeid.
    location /api/ {
        proxy_pass http://${API_HOST}:${API_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}